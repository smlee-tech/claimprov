@prefix cp:   <https://w3id.org/claimprov#> .
@prefix cps:  <https://w3id.org/claimprov/shapes#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

###############################################################################
# claimprov SHACL shapes
#
# Two severities, by design:
#   sh:Violation — storage-time rules. A claim that declares a status without
#                  the evidence that status requires is malformed and must not
#                  be stored.
#   sh:Warning   — retrieval-time signals. A consumer enacting a higher status
#                  than was declared is not malformed data; it is the
#                  declared/enacted divergence the library exists to surface.
#
# Validate with the ontology loaded as ont_graph so cp:trustRank is visible.
###############################################################################

#------------------------------------------------------------------------------
# Every claim
#------------------------------------------------------------------------------

cps:ClaimShape a sh:NodeShape ;
    sh:targetClass cp:Claim ;
    sh:property [
        sh:path cp:statement ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A claim needs exactly one cp:statement." ;
    ] ;
    sh:property [
        sh:path cp:declaredStatus ;
        sh:in ( cp:Asserted cp:Derived cp:ToolVerified cp:HumanVerified ) ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A claim needs exactly one cp:declaredStatus from the closed set." ;
    ] ;
    sh:property [
        sh:path prov:wasAttributedTo ;
        sh:class prov:Agent ;
        sh:minCount 1 ;
        sh:message "A claim must be attributed to at least one prov:Agent." ;
    ] ;
    sh:property [
        sh:path prov:generatedAtTime ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cp:confidence ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path prov:wasDerivedFrom ;
        sh:or ( [ sh:class cp:Claim ] [ sh:class cp:Evidence ] ) ;
        sh:message "prov:wasDerivedFrom on a claim must point at a cp:Claim or cp:Evidence." ;
    ] ;
    sh:property [
        sh:path cp:verifiedBy ;
        sh:class cp:Verification ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A claim cannot be derived from itself." ;
        sh:prefixes <https://w3id.org/claimprov/shapes> ;
        sh:select """
            SELECT $this WHERE { $this prov:wasDerivedFrom $this . }
        """ ;
    ] .

#------------------------------------------------------------------------------
# Per-status minimum requirements
#------------------------------------------------------------------------------

cps:DerivedClaimShape a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:prefixes <https://w3id.org/claimprov/shapes> ;
        sh:select "SELECT ?this WHERE { ?this cp:declaredStatus cp:Derived . }" ;
    ] ;
    sh:property [
        sh:path prov:wasDerivedFrom ;
        sh:qualifiedValueShape [ sh:class cp:Claim ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "declaredStatus=Derived requires at least one source claim via prov:wasDerivedFrom." ;
    ] .

cps:ToolVerifiedClaimShape a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:prefixes <https://w3id.org/claimprov/shapes> ;
        sh:select "SELECT ?this WHERE { ?this cp:declaredStatus cp:ToolVerified . }" ;
    ] ;
    sh:property [
        sh:path cp:verifiedBy ;
        sh:qualifiedValueShape cps:PassedByToolOrPerson ;
        sh:qualifiedMinCount 1 ;
        sh:message "declaredStatus=ToolVerified requires a passed cp:Verification associated with a cp:Tool or prov:Person that cites evidence." ;
    ] .

cps:HumanVerifiedClaimShape a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:prefixes <https://w3id.org/claimprov/shapes> ;
        sh:select "SELECT ?this WHERE { ?this cp:declaredStatus cp:HumanVerified . }" ;
    ] ;
    sh:property [
        sh:path cp:verifiedBy ;
        sh:qualifiedValueShape cps:PassedByPerson ;
        sh:qualifiedMinCount 1 ;
        sh:message "declaredStatus=HumanVerified requires a passed cp:Verification associated with a prov:Person that cites evidence." ;
    ] .

# Reusable verification shapes ------------------------------------------------

cps:PassedByPerson a sh:NodeShape ;
    sh:class cp:Verification ;
    sh:property [ sh:path cp:outcome ; sh:hasValue cp:Passed ] ;
    sh:property [ sh:path prov:wasAssociatedWith ; sh:qualifiedValueShape [ sh:class prov:Person ] ; sh:qualifiedMinCount 1 ] ;
    sh:property [ sh:path prov:used ; sh:qualifiedValueShape [ sh:class cp:Evidence ] ; sh:qualifiedMinCount 1 ] .

cps:PassedByToolOrPerson a sh:NodeShape ;
    sh:class cp:Verification ;
    sh:property [ sh:path cp:outcome ; sh:hasValue cp:Passed ] ;
    sh:property [
        sh:path prov:wasAssociatedWith ;
        sh:qualifiedValueShape [ sh:or ( [ sh:class cp:Tool ] [ sh:class prov:Person ] ) ] ;
        sh:qualifiedMinCount 1 ;
    ] ;
    sh:property [ sh:path prov:used ; sh:qualifiedValueShape [ sh:class cp:Evidence ] ; sh:qualifiedMinCount 1 ] .

#------------------------------------------------------------------------------
# Verification activities must be well-formed and must not be LLM-performed
#------------------------------------------------------------------------------

cps:VerificationShape a sh:NodeShape ;
    sh:targetClass cp:Verification ;
    sh:property [ sh:path cp:outcome ; sh:in ( cp:Passed cp:Failed cp:Inconclusive ) ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cp:method ; sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:property [ sh:path prov:wasAssociatedWith ; sh:class prov:Agent ; sh:minCount 1 ] ;
    sh:property [
        sh:path prov:wasAssociatedWith ;
        sh:not [ sh:class cp:LLMAgent ] ;
        sh:message "A cp:Verification cannot be associated with a cp:LLMAgent. An LLM re-reading a claim is not verification." ;
    ] .

#------------------------------------------------------------------------------
# Status laundering (cross-claim, storage-time violation)
#
# A claim whose declared trust rank exceeds the rank of any of its source
# claims, without a passed verification of its own, has laundered status
# through derivation. Inference does not confer verification.
#------------------------------------------------------------------------------

cps:StatusLaunderingShape a sh:NodeShape ;
    sh:targetClass cp:Claim ;
    sh:severity sh:Violation ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Status laundering: {$this} declares rank {?rank} but is derived from {?src} at rank {?srcRank} and carries no passed verification of its own." ;
        sh:prefixes <https://w3id.org/claimprov/shapes> ;
        sh:select """
            SELECT $this ?src ?rank ?srcRank WHERE {
                $this prov:wasDerivedFrom ?src .
                ?src a cp:Claim .
                $this cp:declaredStatus/cp:trustRank ?rank .
                ?src  cp:declaredStatus/cp:trustRank ?srcRank .
                FILTER (?rank > ?srcRank)
                FILTER NOT EXISTS { $this cp:verifiedBy ?v . ?v cp:outcome cp:Passed . }
            }
        """ ;
    ] .

#------------------------------------------------------------------------------
# Retrieval-time divergence (warning, not violation)
#------------------------------------------------------------------------------

cps:RetrievalShape a sh:NodeShape ;
    sh:targetClass cp:Retrieval ;
    sh:property [ sh:path prov:used ; sh:class cp:Claim ; sh:minCount 1 ] ;
    sh:property [ sh:path prov:wasAssociatedWith ; sh:class prov:Agent ; sh:minCount 1 ] ;
    sh:property [ sh:path cp:enactedStatus ; sh:in ( cp:Asserted cp:Derived cp:ToolVerified cp:HumanVerified ) ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cp:requiredStatus ; sh:in ( cp:Asserted cp:Derived cp:ToolVerified cp:HumanVerified ) ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "A retrieval must record the status its acceptance policy required." ] ;
    sh:property [ sh:path cp:observedUse ; sh:in ( cp:Prediction cp:Decision cp:EventRecord ) ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "A retrieval must record the kind of record the consumer produced." ] ;
    sh:property [ sh:path cp:reviewed ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Enacted status must equal required status; it is derived, not annotated." ;
        sh:prefixes <https://w3id.org/claimprov/shapes> ;
        sh:select """
            SELECT $this WHERE {
                $this cp:enactedStatus ?e ; cp:requiredStatus ?r .
                FILTER (?e != ?r)
            }
        """ ;
    ] .

cps:AssetShape a sh:NodeShape ;
    sh:targetClass cp:Asset ;
    sh:property [ sh:path cp:defaultStatus ; sh:in ( cp:Asserted cp:Derived cp:ToolVerified cp:HumanVerified ) ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "An asset must declare the default status its certification confers." ] .

# Inflation: the use required more warrant than the claim declared, and nothing
# reviewed it on the way. A provisional input used for a purpose the policy
# permits on provisional evidence is NOT inflation.
cps:StatusInflationShape a sh:NodeShape ;
    sh:targetClass cp:Retrieval ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Status inflation at retrieval: {$this} produced a {?use} that required rank {?required} from {?claim}, which declares rank {?declared}; no review." ;
        sh:prefixes <https://w3id.org/claimprov/shapes> ;
        sh:select """
            SELECT $this ?claim ?use ?required ?declared WHERE {
                $this prov:used ?claim .
                ?claim a cp:Claim .
                $this  cp:observedUse ?use .
                $this  cp:requiredStatus/cp:trustRank ?required .
                ?claim cp:declaredStatus/cp:trustRank ?declared .
                FILTER (?required > ?declared)
                FILTER NOT EXISTS { $this cp:reviewed true }
            }
        """ ;
    ] .

# Reviewed inflation: same gap, but evaluative mediation happened. Reported at
# Info so the gap stays visible without being counted as a divergence.
cps:ReviewedGapShape a sh:NodeShape ;
    sh:targetClass cp:Retrieval ;
    sh:severity sh:Info ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Gap closed by review: {$this} required rank {?required} from {?claim} (declared rank {?declared}); use was reviewed." ;
        sh:prefixes <https://w3id.org/claimprov/shapes> ;
        sh:select """
            SELECT $this ?claim ?required ?declared WHERE {
                $this prov:used ?claim .
                ?claim a cp:Claim .
                $this  cp:requiredStatus/cp:trustRank ?required .
                ?claim cp:declaredStatus/cp:trustRank ?declared .
                $this  cp:reviewed true .
                FILTER (?required > ?declared)
            }
        """ ;
    ] .

# Asset inheritance (the record path): a claim stored in an asset whose default
# status outranks the claim's declared status is read, by anything that reads
# the asset rather than the claim, at the asset's standing. Warning, because the
# stored data is well-formed; the gap is in what the container confers.
cps:AssetInheritanceShape a sh:NodeShape ;
    sh:targetClass cp:Claim ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Asset inheritance: {$this} declares rank {?declared} but is stored in {?asset}, certified at rank {?assetRank}; a reader of the asset obtains the higher standing." ;
        sh:prefixes <https://w3id.org/claimprov/shapes> ;
        sh:select """
            SELECT $this ?asset ?declared ?assetRank WHERE {
                $this cp:storedIn ?asset .
                ?asset a cp:Asset .
                $this  cp:declaredStatus/cp:trustRank ?declared .
                ?asset cp:defaultStatus/cp:trustRank  ?assetRank .
                FILTER (?assetRank > ?declared)
            }
        """ ;
    ] .

#------------------------------------------------------------------------------
# Prefix declarations for the SPARQL constraints above
#------------------------------------------------------------------------------

<https://w3id.org/claimprov/shapes>
    sh:declare [ sh:prefix "cp"   ; sh:namespace "https://w3id.org/claimprov#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "prov" ; sh:namespace "http://www.w3.org/ns/prov#"^^xsd:anyURI ] .
